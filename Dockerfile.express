# ===========================================
# Stage 1 — Build TypeScript
# ===========================================
FROM node:20-bullseye AS builder
LABEL maintainer="NanoScape Engineering <support@nanoscape.id>"

WORKDIR /app

# Copy dependency files
COPY package*.json ./
RUN npm install

# Copy project source & config
COPY tsconfig.json ./
COPY src ./src

# Build TypeScript → /app/dist
RUN npm run build

# Copy environment file (optional but useful)
COPY .env ./


# ===========================================
# Stage 2 — Runtime Environment
# ===========================================
FROM node:20-slim

RUN apt-get update && apt-get install -y \
    curl python3 python3-crcmod gnupg \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Add non-root user
RUN adduser --disabled-login --gecos '' appuser

WORKDIR /app

# Copy compiled app & essentials
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/.env ./
COPY service_account.json /app/service_account.json

# Install only production dependencies
RUN npm ci --omit=dev

# ✅ FIX: Create logs folder BEFORE switching to appuser
RUN mkdir -p /app/logs && chmod -R 777 /app/logs

# Set environment variables
ENV NODE_ENV=production
ENV GOOGLE_APPLICATION_CREDENTIALS=/app/service_account.json

# Switch to non-root user
USER appuser

EXPOSE 5000

# Start app
CMD ["node", "dist/index.js"]
